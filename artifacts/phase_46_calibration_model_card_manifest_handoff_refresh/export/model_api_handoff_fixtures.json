        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.atsFriendliness.summary"
      },
      {
        "model_core": "overallImpression.summary",
        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.overallImpression"
      },
      {
        "model_core": "candidateReranking.recommendations[].jobId",
        "owner": "backend-hydration",
        "wrapper_target": "analysisResult.jobRecommendations[].jobId"
      },
      {
        "model_core": "candidateReranking.recommendations[].matchScore",
        "owner": "model",
        "wrapper_target": "analysisResult.jobRecommendations[].matchScore"
