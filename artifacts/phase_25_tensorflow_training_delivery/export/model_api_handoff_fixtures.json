{
  "cv_analysis_v2_wrapper_mapping": {
    "boundary_note": "Training exports model-core scores/signals only. Backend/API wrapper owns prose, generated actionables, section reviews, CV file handling, auth, persistence, and job detail hydration.",
    "model_core_to_wrapper": [
      {
        "model_core": "jobFitAlignment.score",
        "owner": "model",
        "wrapper_target": "analysisResult.jobFitAlignment.score"
      },
      {
        "model_core": "jobFitAlignment.summarySignals + missingSkills",
        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.jobFitAlignment.summary"
      },
      {
        "model_core": "atsFriendliness.score",
        "owner": "model",
        "wrapper_target": "analysisResult.atsFriendliness.score"
      },
      {
        "model_core": "atsFriendliness.detectedIssues",
        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.atsFriendliness.summary"
      },
      {
        "model_core": "overallImpression.summary",
        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.overallImpression"
      },
      {
        "model_core": "candidateReranking.recommendations[].jobId",
        "owner": "backend-hydration",
        "wrapper_target": "analysisResult.jobRecommendations[].jobId"
      },
      {
        "model_core": "candidateReranking.recommendations[].matchScore",
        "owner": "model",
        "wrapper_target": "analysisResult.jobRecommendations[].matchScore"
      },
      {
        "model_core": "candidateReranking.recommendations[].matchedSkills + missingSkills + rankingSignals",
        "owner": "api-wrapper",
        "wrapper_target": "analysisResult.jobRecommendations[].reason + nextStep"
      }
    ],
