# Optional root-level model workspace defaults.
# Model API reads model_api/.env.example as the primary service template.
# Copy this file to .env only if a local tool expects root-level orchestration values.

MODEL_API_BASE_URL=http://localhost:8000
MODEL_API_SERVICE_TOKEN=replace-with-local-service-token
MODEL_API_ENABLE_GENAI_WRAPPER=false
MODEL_API_ENABLE_MOCK=true

# External Backend API repository, not part of this repo:
# https://github.com/bisa-kerja/bisakerja-api
BACKEND_API_REPOSITORY=https://github.com/bisa-kerja/bisakerja-api
