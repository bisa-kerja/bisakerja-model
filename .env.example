# Root local orchestration template
# Copy service-specific examples instead of putting secrets here.

# Backend API
BACKEND_ENV_FILE=references/.env.example
BACKEND_BASE_URL=http://localhost:3000

# Model API
MODEL_API_ENV_FILE=model_api/.env.example
MODEL_API_BASE_URL=http://localhost:8000
MODEL_API_SERVICE_TOKEN=replace-with-local-service-token

# Safety
MODEL_API_ENABLE_GENAI_WRAPPER=false
MODEL_API_ENABLE_MOCK=true
